// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]    @relation("CategoryHierarchy")
  sortOrder Int           @default(0)

  // One category can be the result of many rules
  rules     CategoryRule[]
  
  // Merchant patterns that reference this category
  merchantPatterns MerchantPattern[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
}

model CategoryRule {
  id          String   @id @default(cuid())

  // 'system' or 'user'
  source      String   @default("user")

  enabled     Boolean  @default(true)
  score       Int      @default(200)

  // The category id we set if this rule matches.
  // This should reference Category.id, but we keep the raw string field as well.
  setCategory String
  category    Category @relation(fields: [setCategory], references: [id], onDelete: Restrict)

  // JSON blob with match conditions (direction, contains, regex, ibanEquals, mccIn, merchantEquals, minAmountAbs, maxAmountAbs).
  // Stored as String since SQLite doesn't support Json type.
  whenJson    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, score])
  @@index([source])
}

model MerchantPattern {
  id         String    @id @default(cuid())
  
  source     String    @default("user")
  pattern    String
  normalized String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  score      Int       @default(100)
  exact      Boolean   @default(false)
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@index([source])
  @@index([categoryId])
}

model Budget {
  id          String                  @id @default(cuid())
  name        String
  period      String                  // 'monthly' | 'weekly' | 'yearly'
  periodValue String                  // e.g., '2025-10' for monthly, '2025-W42' for weekly, '2025' for yearly
  currency    String                  @default("EUR")
  rolloverEnabled Boolean             @default(false)
  
  allocations BudgetCategoryAllocation[]
  
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  
  @@index([period, periodValue])
  @@index([createdAt])
}

model BudgetCategoryAllocation {
  id         String   @id @default(cuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String   // Category ID (may reference Category.id or be a string like 'groceries')
  plannedCents Int    // Planned amount in cents (EUR)
  rolloverFromPrevious Boolean @default(false)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([budgetId])
  @@index([categoryId])
  @@unique([budgetId, categoryId])
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  type        String   // 'savings' | 'debt' | 'net_worth'
  targetCents Int      // Target amount in cents (EUR)
  currentCents Int     @default(0) // Current amount (can be updated manually or computed)
  targetDate  DateTime? // Optional target date
  currency    String   @default("EUR")
  
  // Linked accounts/categories (JSON array of IDs)
  // Stored as String since SQLite doesn't support Json type.
  linkedAccountIds String? // Array of account IDs (JSON string)
  linkedCategoryIds String? // Array of category IDs (JSON string)
  
  // Metadata
  description String?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([type])
  @@index([targetDate])
  @@index([isActive])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "first_import"
  title       String
  description String
  type        String   // "import", "reimbursement", "budget", "goal", "streak"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userAchievements UserAchievement[]
  
  @@index([type])
  @@index([key])
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String   @default("default")  // Single-user app, default to "default"
  achievementId  String
  achievement    Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  status         String   // "locked" | "in_progress" | "completed"
  progress       Int      @default(0)  // 0–100
  unlockedAt     DateTime?
  lastUpdatedAt  DateTime @default(now())
  
  @@index([userId])
  @@index([achievementId])
  @@unique([userId, achievementId])
}

model Account {
  id            String   @id @default(cuid())
  name          String
  type          String   // 'CHECKING' | 'SAVINGS' | 'CREDIT_CARD' | 'CASH' | 'OTHER'
  iban          String?
  accountNumber String?
  isPrimary     Boolean  @default(false)
  isArchived    Boolean  @default(false)  // Soft delete flag
  userId        String   @default("default")  // Single-user app, default to "default"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([isArchived])
  @@index([isPrimary])
}

model QuestDefinition {
  id          String   @id  // e.g., "cleanup_sonstiges"
  title       String
  description String
  kind        String   // 'CLEANUP' | 'IMPORT' | 'SPENDING' | 'OTHER'
  targetValue REAL     // Target value (e.g., 0 for "0 remaining Sonstiges")
  unit        String   // e.g., "transactions", "percent", "months"
  isActive    Boolean  @default(true)
  configJson  String?  // Optional JSON for quest-specific parameters (stored as TEXT in SQLite)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userQuestStates UserQuestState[]
  
  @@index([isActive])
  @@index([kind])
}

model UserQuestState {
  id              String   @id  // Composite: "${userId}:${questId}"
  userId          String   @default("default")  // Single-user app, default to "default"
  questId         String
  questDefinition QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)
  status          String   // 'LOCKED' | 'ACTIVE' | 'COMPLETED'
  currentValue    REAL     @default(0)
  targetValue     REAL     // Denormalized from QuestDefinition for snapshot
  progressPercent REAL     @default(0)  // 0–100
  startedAt       DateTime?
  completedAt     DateTime?
  metadataJson    String?  // Optional JSON for future AI notes, etc. (stored as TEXT in SQLite)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([questId])
  @@index([status])
  @@unique([userId, questId])
}

